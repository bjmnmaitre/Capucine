# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-...

# Database Configuration
DATABASE_URL=

# Server Configuration
NODE_ENV=development
PORT=5000

# Logging
LOG_LEVEL=info

# COMMENT CE FICHIER EST LU
# Copiez-le en `.env` (non versionné). Les scripts `npm run dev` et
# `npm start` le chargent via `node --env-file-if-exists=.env`. Si le fichier
# est absent, le serveur démarre normalement sans lui.
# ATTENTION : `npx tsx src/api/server.ts` lancé directement NE lit PAS ce
# fichier — passez par `npm run dev`, sinon vos clés seront ignorées en
# silence et /health répondra "no_real_source".

# ── Recherche Web ────────────────────────────────────────────────────────────
# Sans AUCUNE de ces deux clés, Capucine n'interroge aucun moteur : la
# découverte Web s'exécute mais ne reçoit rien, et les offres proviennent
# uniquement du catalogue local. Vérifier l'état réel :
#   curl -s localhost:3001/health | grep -o '"webSearch":{[^}]*}'
#   → "status":"configured"     : au moins un vrai fournisseur est joignable
#   → "status":"no_real_source" : aucun fournisseur, catalogue local seulement
# Une seule des deux suffit ; les deux ensemble sont interrogées en parallèle.
BRAVE_API_KEY=
SERPER_API_KEY=

# ── Interprétation IA ───────────────────────────────────────────────────────
# Facultatif. Sans rien ici, Capucine interprète les requêtes en mode
# heuristique (MockAIProvider) : rapide (~4 s) et suffisant pour la plupart
# des recherches. Chaque sortie IA est de toute façon revalidée avant usage,
# et les décisions déterministes le restent.
#
# OLLAMA_MODEL active un modèle LOCAL (via `ollama serve`) — aucune clé,
# rien ne quitte la machine, aucun coût. Choisi en priorité sur les
# fournisseurs payants quand il est défini. S'il est injoignable à l'appel,
# l'orchestrateur bascule sur le fournisseur suivant (ou l'heuristique).
# Compter ~30–40 s de plus sur la première recherche — à n'activer que si
# cette latence est acceptable pour le test en cours.
#   ollama list                       # modèles disponibles localement
#   curl -s localhost:3001/health | grep -o '"aiProviders":{[^}]*}'
#   → "configured":["ollama"]         : le modèle local est pris en compte
OLLAMA_MODEL=
# OLLAMA_HOST=http://127.0.0.1:11434            # défaut si absent
# OLLAMA_MODEL_REASONING=                       # modèle plus lourd, tier "reasoning" seul
# OLLAMA_TIMEOUT_MS=90000                       # plafond par appel (défaut 90 s)
#
# NOTE latence : sur le chemin /search, l'IA ne sert QU'À enrichir les termes
# de recherche (synonymes) — étape optionnelle. Un plafond serré la coupe pour
# ne pas retarder la recherche : AI_ENRICHMENT_TIMEOUT_MS (défaut 6000, 0 =
# désactivé). Une recherche avec Ollama lent revient donc à « recherche sans
# synonymes IA », pas à « recherche bloquée ».
# AI_ENRICHMENT_TIMEOUT_MS=6000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Laisser VIDE pour l'application Expo Go native (elle n'envoie pas de
# preflight). À renseigner uniquement pour un client navigateur, avec
# l'origine exacte — jamais '*'. Exemple pour Expo web : http://localhost:8081
CORS_ORIGIN=
